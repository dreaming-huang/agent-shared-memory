# Copy to config.env (gitignored) and fill in. Never commit real values to a public repo.
# 复制为 config.env（已被 .gitignore）后填写。切勿把真实值提交到公开仓库。
# Placeholders only — replace with YOUR remote-server Host aliases and paths.
# 以下均为占位符，请换成你自己的远程服务器 Host 别名与路径。

# --- Workstation / collector ---
SHARED_MEMORY_ROOT="$HOME/shared-memory"
# Local timezone label for filenames & frontmatter (example)
MEMORY_TZ="Asia/Shanghai"

# --- SSH Host aliases from ~/.ssh/config (NOT raw IPs) ---
SSH_HOST_A="jump-a"                 # jump host for server-a
SSH_HOST_B="server-b"
SSH_HOST_W="server-workstation"
# Optional fallback aliases (still Host names, not IPs)
# SSH_HOST_A_FALLBACK="jump-a-alt"
# SSH_HOST_W_FALLBACK="server-workstation-alt"

# --- server-a ---
MIRROR_ROOT_A="/data/shared-memory"
MEMORY_INBOX_A="/data/memory_inbox"
# Same filesystem when seen from inside a training pod / container:
MEMORY_INBOX_A_IN_POD="/mnt/group/memory_inbox"

# --- server-b ---
MIRROR_ROOT_B="/share/shared-memory"
MEMORY_INBOX_B="/share/memory_inbox"

# --- server-workstation ---
MIRROR_ROOT_W="$HOME/shared-memory"
MEMORY_INBOX_W="$HOME/memory_inbox"

# --- Collector schedule hints (cron examples; adjust locally) ---
# Mirror pull on remote servers:  minute 17 hourly → git -C $MIRROR_ROOT_* pull --ff-only
# Writer patrol:                  minute 35 hourly
# Collector run:                  minute 47 hourly
